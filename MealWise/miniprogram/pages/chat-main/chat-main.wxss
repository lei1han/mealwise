/* 聊天主流程 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--xc-background);
}

/* ---- 导航栏 ---- */
.nav-bar {
  background-color: var(--xc-background);
  border-bottom: 1rpx solid var(--xc-border);
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--xc-foreground);
}

.nav-actions {
  display: flex;
  gap: 32rpx;
}

.nav-action {
  font-size: 28rpx;
  color: var(--xc-muted-foreground);
}

/* ---- 聊天区域 ---- */
.chat-scroll {
  flex: 1;
  overflow-y: auto;
}

.chat-list {
  padding: 24rpx 32rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 32rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-coach {
  justify-content: flex-start;
}

/* 头像 */
.msg-avatar {
  flex-shrink: 0;
  margin-right: 16rpx;
}

.coach-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--xc-primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--xc-primary);
}

/* 教练头像图片（云端配置 coach_avatar_url；与文字占位同尺寸圆形裁切） */
.avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: block;
}

/* 气泡 */
.msg-bubble {
  max-width: 75%;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}

.msg-bubble-coach {
  background-color: var(--xc-surface);
  color: var(--xc-foreground);
  border: 1rpx solid var(--xc-border);
  border-radius: var(--xc-radius-lg) var(--xc-radius-lg) var(--xc-radius-lg) var(--xc-radius-xs);
  box-shadow: var(--xc-shadow-1);
}

.msg-bubble-user {
  background-color: var(--xc-primary);
  color: #FFFFFF;
  border-radius: var(--xc-radius-lg) var(--xc-radius-xs) var(--xc-radius-lg) var(--xc-radius-lg);
}

/* 预算卡片 */
.budget-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background-color: var(--xc-surface-2);
  border-radius: var(--xc-radius-md);
  box-shadow: var(--xc-shadow-1);
}

.budget-row {
  display: flex;
  justify-content: space-between;
}

.budget-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.budget-label {
  font-size: 22rpx;
  color: var(--xc-muted-foreground);
}

.budget-value {
  font-size: 36rpx;
  font-weight: 700;
}

.budget-unit {
  font-size: 20rpx;
  color: var(--xc-muted-foreground);
}

.budget-total {
  color: var(--xc-foreground);
}

.budget-consumed {
  color: var(--xc-state-accent);
}

.budget-remaining {
  color: var(--xc-primary);
}

/* 预算进度条 */
.budget-progress {
  margin-top: 16rpx;
  height: 8rpx;
  background-color: var(--xc-border);
  border-radius: 4rpx;
  overflow: hidden;
}

.budget-bar {
  height: 100%;
  max-width: 100%;
  background-color: var(--xc-state-accent);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 28rpx;
  background-color: var(--xc-surface);
  border: 1rpx solid var(--xc-border);
  border-radius: var(--xc-radius-lg);
  box-shadow: var(--xc-shadow-1);
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--xc-muted-foreground);
  animation: dotPulse 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

/* 催报卡片 */
.reminder-card {
  position: relative;
  display: flex;
  flex-direction: column;
  margin: 0 0 28rpx;
  padding: 20rpx 24rpx 22rpx;
  background-color: var(--xc-surface);
  border: 2rpx solid var(--xc-state-accent);
  border-radius: var(--xc-radius-md);
  box-shadow: var(--xc-shadow-1);
}

.reminder-close {
  position: absolute;
  top: 14rpx;
  right: 18rpx;
  padding: 4rpx 10rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--xc-muted-foreground);
  z-index: 1;
}

.reminder-body {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.reminder-icon {
  flex-shrink: 0;
  font-size: 44rpx;
  margin-right: 18rpx;
  margin-top: 4rpx;
}

.reminder-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding-right: 36rpx;
}

.reminder-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--xc-foreground);
  line-height: 1.35;
}

.reminder-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--xc-muted-foreground);
  line-height: 1.45;
}

.reminder-btn {
  align-self: flex-end;
  margin-top: 16rpx;
  padding: 10rpx 22rpx;
  background-color: var(--xc-state-accent);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: var(--xc-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

.chat-bottom {
  height: 20rpx;
}

/* ---- 输入栏 ---- */
.input-bar {
  background-color: var(--xc-background);
  border-top: 1rpx solid var(--xc-border);
  box-shadow: 0 -4rpx 16rpx rgba(26, 38, 32, 0.04);
  flex-shrink: 0;
}

.input-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx;
}

/* 包裹层负责 flex 拉伸（原生 input 直接做 flex 子项不生效） */
.input-wrap {
  flex: 1 1 auto;
  min-width: 0;
  display: block;
}

.chat-input {
  width: 100%;
  height: 88rpx;
  padding: 0 15rpx;
  background-color: var(--xc-surface);
  border: 1rpx solid var(--xc-input);
  border-radius: var(--xc-radius-pill);
  font-size: 30rpx;
  color: var(--xc-foreground);
  box-sizing: border-box;
}

.chat-input-ph {
  color: var(--xc-placeholder);
}

.send-btn {
  /* 用 view 承载发送按钮：规避原生 button 默认块级宽度（flex 中会被拉成与输入框均分） */
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--xc-radius-pill);
  border: none;
  box-sizing: border-box;
}

/* 禁用态（view 无 disabled 属性，用 class 控制） */
.send-btn-disabled {
  background-color: var(--xc-primary-50);
  color: rgba(78, 122, 92, 0.55);
}

.send-btn-active {
  background-color: var(--xc-primary);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(78, 122, 92, 0.28);
}
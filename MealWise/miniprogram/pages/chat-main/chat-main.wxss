/* 聊天主流程 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--xc-background);
}

/* ---- 导航栏（服务号） ---- */
.nav-bar {
  background-color: var(--xc-surface);
  border-bottom: 1rpx solid var(--xc-border);
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nav-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--xc-primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: block;
}

.avatar-icon-sm {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--xc-primary);
}

.nav-snark-badge {
  padding: 4rpx 16rpx;
  background-color: var(--xc-primary-50);
  color: var(--xc-primary);
  font-size: 22rpx;
  font-weight: 600;
  border-radius: var(--xc-radius-pill);
}

.nav-more-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--xc-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--xc-muted-foreground);
}

.more-dots {
  font-size: 28rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}

/* ---- 今日进度条（sticky） ---- */
.progress-sticky {
  background-color: var(--xc-surface);
  border-bottom: 1rpx solid var(--xc-border);
  padding: 16rpx 32rpx 20rpx;
  flex-shrink: 0;
}

.progress-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.progress-label {
  font-size: 24rpx;
  color: var(--xc-muted-foreground);
}

.progress-status {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--xc-primary);
}

.progress-value-row {
  margin-top: 6rpx;
}

.progress-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--xc-primary);
}

.progress-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--xc-muted-foreground);
}

.progress-track {
  margin-top: 12rpx;
  height: var(--xc-progress-bar-height);
  background-color: var(--xc-progress-track);
  border-radius: var(--xc-radius-pill);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: var(--xc-progress-fill);
  border-radius: var(--xc-radius-pill);
  transition: width 0.3s ease;
}

/* ---- 聊天区域 ---- */
.chat-scroll {
  flex: 1;
  overflow-y: auto;
}

.chat-list {
  padding: 24rpx 32rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 32rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-coach {
  justify-content: flex-start;
}

/* 头像 */
.msg-avatar {
  flex-shrink: 0;
  margin-right: 16rpx;
}

.coach-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--xc-primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--xc-primary);
}

/* 教练头像图片（云端配置 coach_avatar_url；与文字占位同尺寸圆形裁切） */
.avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: block;
}

/* 气泡 */
.msg-bubble {
  max-width: 75%;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}

.msg-bubble-coach {
  background-color: var(--xc-surface);
  color: var(--xc-foreground);
  border: 1rpx solid var(--xc-border);
  border-radius: var(--xc-radius-lg) var(--xc-radius-lg) var(--xc-radius-lg) var(--xc-radius-xs);
  box-shadow: var(--xc-shadow-1);
}

.msg-bubble-user {
  background-color: var(--xc-primary);
  color: #FFFFFF;
  border-radius: var(--xc-radius-lg) var(--xc-radius-xs) var(--xc-radius-lg) var(--xc-radius-lg);
}

/* 本餐食物明细表 */
.diet-card {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background-color: var(--xc-surface-2);
  border-radius: var(--xc-radius-md);
  box-shadow: var(--xc-shadow-1);
}

.diet-card-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.diet-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--xc-foreground);
}

.diet-card-total {
  font-size: 22rpx;
  color: var(--xc-primary);
  font-weight: 600;
  flex-shrink: 0;
}

.diet-table {
  border: 1rpx solid var(--xc-border);
  border-radius: var(--xc-radius-sm);
  overflow: hidden;
}

.diet-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 16rpx;
  border-top: 1rpx solid var(--xc-border);
}

.diet-row:first-child {
  border-top: none;
}

.diet-row-head {
  background-color: var(--xc-muted);
}

.diet-row-head .diet-col {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--xc-muted-foreground);
}

.diet-col {
  font-size: 24rpx;
  color: var(--xc-foreground);
  line-height: 1.4;
}

.diet-col-name {
  flex: 1.1;
  padding-right: 8rpx;
}

.diet-col-kcal {
  width: 120rpx;
  text-align: right;
  font-weight: 600;
  color: var(--xc-state-accent);
  flex-shrink: 0;
}

.diet-col-note {
  flex: 1.4;
  font-size: 22rpx;
  color: var(--xc-muted-foreground);
  padding-left: 12rpx;
}

.diet-estimated-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--xc-muted-foreground);
}

/* 预算卡片 */
.budget-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background-color: var(--xc-surface-2);
  border-radius: var(--xc-radius-md);
  box-shadow: var(--xc-shadow-1);
}

.budget-row {
  display: flex;
  justify-content: space-between;
}

.budget-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.budget-label {
  font-size: 22rpx;
  color: var(--xc-muted-foreground);
}

.budget-value {
  font-size: 36rpx;
  font-weight: 700;
}

.budget-unit {
  font-size: 20rpx;
  color: var(--xc-muted-foreground);
}

.budget-total {
  color: var(--xc-foreground);
}

.budget-consumed {
  color: var(--xc-state-accent);
}

.budget-remaining {
  color: var(--xc-primary);
}

/* 预算进度条 */
.budget-progress {
  margin-top: 16rpx;
  height: 8rpx;
  background-color: var(--xc-border);
  border-radius: 4rpx;
  overflow: hidden;
}

.budget-bar {
  height: 100%;
  max-width: 100%;
  background-color: var(--xc-state-accent);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 28rpx;
  background-color: var(--xc-surface);
  border: 1rpx solid var(--xc-border);
  border-radius: var(--xc-radius-lg);
  box-shadow: var(--xc-shadow-1);
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--xc-muted-foreground);
  animation: dotPulse 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

/* 催报卡片 */
.reminder-card {
  position: relative;
  display: flex;
  flex-direction: column;
  margin: 0 0 28rpx;
  padding: 20rpx 24rpx 22rpx;
  background-color: var(--xc-surface);
  border: 2rpx solid var(--xc-state-accent);
  border-radius: var(--xc-radius-md);
  box-shadow: var(--xc-shadow-1);
}

.reminder-close {
  position: absolute;
  top: 14rpx;
  right: 18rpx;
  padding: 4rpx 10rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--xc-muted-foreground);
  z-index: 1;
}

.reminder-body {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.reminder-icon {
  flex-shrink: 0;
  font-size: 44rpx;
  margin-right: 18rpx;
  margin-top: 4rpx;
}

.reminder-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding-right: 36rpx;
}

.reminder-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--xc-foreground);
  line-height: 1.35;
}

.reminder-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--xc-muted-foreground);
  line-height: 1.45;
}

.reminder-btn {
  align-self: flex-end;
  margin-top: 16rpx;
  padding: 10rpx 22rpx;
  background-color: var(--xc-state-accent);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: var(--xc-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

.chat-bottom {
  height: 20rpx;
}

/* ---- 输入栏 ---- */
.input-bar {
  background-color: var(--xc-background);
  border-top: 1rpx solid var(--xc-border);
  box-shadow: var(--xc-shadow-input-bar);
  flex-shrink: 0;
}

.input-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx;
}

/* 左侧切换按钮：菜单开→键盘图标；关→菜单图标 */
.input-toggle-btn {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--xc-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--xc-muted-foreground);
}

.input-toggle-active {
  color: var(--xc-primary);
}

.toggle-icon {
  font-size: 36rpx;
  line-height: 1;
}

/* 包裹层负责 flex 拉伸（原生 input 直接做 flex 子项不生效） */
.input-wrap {
  flex: 1 1 auto;
  min-width: 0;
  display: block;
}

.chat-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: var(--xc-surface);
  border: 1rpx solid var(--xc-input);
  border-radius: var(--xc-radius-pill);
  font-size: 30rpx;
  color: var(--xc-foreground);
  box-sizing: border-box;
}

.chat-input-ph {
  color: var(--xc-placeholder);
}

/* 圆形图标发送按钮 */
.send-btn {
  /* 用 view 承载发送按钮：规避原生 button 默认块级宽度（flex 中会被拉成与输入框均分） */
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  border: none;
  box-sizing: border-box;
}

.send-icon {
  font-size: 34rpx;
  line-height: 1;
}

/* 禁用态（view 无 disabled 属性，用 class 控制） */
.send-btn-disabled {
  background-color: var(--xc-primary-50);
  color: var(--xc-primary);
  opacity: 0.55;
}

.send-btn-active {
  background-color: var(--xc-primary);
  color: #FFFFFF;
  box-shadow: var(--xc-shadow-send);
}

/* ---- 今日饮食概览（输入栏上方） ---- */
.meal-overview {
  background-color: var(--xc-surface);
  border-top: 1rpx solid var(--xc-border);
  padding: 12rpx 24rpx;
  flex-shrink: 0;
}

.overview-row {
  display: flex;
  align-items: center;
}

.ov-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.ov-label {
  font-size: 20rpx;
  color: var(--xc-muted-foreground);
}

.ov-num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--xc-primary);
}

.ov-none {
  color: var(--xc-muted-foreground);
  font-weight: 400;
}

.ov-arrow {
  width: 48rpx;
}

.ov-arrow-icon {
  font-size: 30rpx;
  color: var(--xc-muted-foreground);
  text-align: right;
}

/* ---- 功能菜单面板（输入栏上方，4 列网格） ---- */
.menu-panel {
  background-color: var(--xc-surface-2);
  border-top: 1rpx solid var(--xc-border);
  padding: 20rpx 24rpx;
  flex-shrink: 0;
}

.menu-grid {
  display: flex;
  justify-content: space-between;
}

.menu-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.menu-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background-color: var(--xc-surface);
  box-shadow: var(--xc-shadow-1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--xc-primary);
}

.menu-label {
  font-size: 22rpx;
  color: var(--xc-foreground);
}
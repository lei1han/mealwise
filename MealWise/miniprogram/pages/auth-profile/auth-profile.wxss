.profile-page {
  height: 100vh;
  background-color: var(--xc-background);
}

.profile-content {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 48rpx 48rpx;
  padding-top: calc(env(safe-area-inset-top) + 120rpx);
}

.header-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--xc-foreground);
}

.subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--xc-muted-foreground);
  text-align: center;
  line-height: 1.5;
}

.avatar-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 72rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--xc-surface);
  box-shadow: var(--xc-shadow-2);
  border: none;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 176rpx;
  height: 176rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--xc-primary-50);
}

.avatar-plus {
  font-size: 64rpx;
  color: var(--xc-primary);
  font-weight: 300;
}

.avatar-hint {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--xc-muted-foreground);
}

.nickname-card {
  margin-top: 64rpx;
  padding: 32rpx 36rpx;
  background: var(--xc-surface);
  border-radius: var(--xc-radius-md);
  box-shadow: var(--xc-shadow-1);
}

.field-label {
  font-size: 26rpx;
  color: var(--xc-muted-foreground);
}

.nickname-input {
  margin-top: 16rpx;
  font-size: 32rpx;
  color: var(--xc-foreground);
  width: 100%;
}

.nickname-placeholder {
  color: var(--xc-placeholder);
}

.btn-area {
  margin-top: auto;
  padding-top: 80rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--xc-primary);
  color: var(--xc-primary-foreground);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--xc-radius-pill);
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.btn-note {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--xc-muted-foreground);
  text-align: center;
  line-height: 1.5;
}

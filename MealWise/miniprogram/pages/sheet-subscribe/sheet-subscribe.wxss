/* 订阅消息授权 */
.sheet-page {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.mask {
  position: absolute;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.3);
}

.sheet {
  position: relative;
  background-color: var(--xc-surface);
  border-radius: var(--xc-radius-lg) var(--xc-radius-lg) 0 0;
  padding: 24rpx 40rpx 64rpx;
  box-shadow: var(--xc-shadow-3);
}

.sheet-handle {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.handle-bar {
  width: 80rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: var(--xc-border);
}

/* 教练提示 */
.coach-bubble {
  padding: 24rpx 28rpx;
  background-color: var(--xc-surface-2);
  border-radius: var(--xc-radius-md);
  font-size: 28rpx;
  color: var(--xc-foreground);
  margin-bottom: 32rpx;
  line-height: 1.6;
}

/* 头像占位 */
.avatar-placeholder {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.avatar-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: var(--xc-primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--xc-primary);
}

/* 功能说明 */
.features {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.feature-dot {
  color: var(--xc-primary);
  font-size: 24rpx;
}

.feature-text {
  font-size: 28rpx;
  color: var(--xc-foreground);
}

/* 按钮 */
.btn-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background-color: var(--xc-primary);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--xc-radius-sm);
  border: none;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-skip {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: var(--xc-muted-foreground);
}
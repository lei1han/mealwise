/* 授权登录页 */
.auth-page {
  height: 100vh;
  background-color: var(--xc-background);
}

.auth-content {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 48rpx;
}

/* ---- 品牌区 ---- */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 15vh;
}

.brand-logo {
  font-size: 112rpx;
  font-weight: 700;
  color: var(--xc-primary);
  line-height: 1;
}

.brand-name {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--xc-primary);
}

.brand-desc {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--xc-muted-foreground);
}

/* ---- 欢迎引导 ---- */
.guide-card {
  margin-top: 80rpx;
  padding: 40rpx;
  background-color: var(--xc-surface);
  border-radius: var(--xc-radius-md);
  box-shadow: var(--xc-shadow-1);
}

.guide-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 16rpx 0;
}

.guide-item + .guide-item {
  border-top: 1rpx solid var(--xc-divider);
  padding-top: 32rpx;
}

.guide-icon {
  flex-shrink: 0;
  margin-top: 4rpx;
}

.icon-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: var(--xc-primary);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.guide-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--xc-foreground);
}

.guide-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--xc-muted-foreground);
  line-height: 1.5;
}

/* ---- 按钮区 ---- */
.btn-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: auto;
  padding-top: 64rpx;
  padding-bottom: 32rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background-color: var(--xc-primary);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--xc-radius-sm);
  border: none;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--xc-muted-foreground);
}

.btn-skip {
  margin-top: 48rpx;
  font-size: 26rpx;
  color: var(--xc-primary);
}

/* ---- 底部协议 ---- */
.agreement {
  padding-bottom: 64rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--xc-placeholder);
}

.agreement-link {
  color: var(--xc-primary);
  text-decoration: underline;
}
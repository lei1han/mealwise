/* ============================================
   三餐教练 全局设计令牌（Design Tokens v3.0）
   配色方案：薄荷马卡龙 v3
   ============================================ */

/* 图标字体：assets/fonts/iconfont.ttf（Font Awesome Free / CC BY 4.0 + SIL OFL）
   码位见 assets/build_iconfont.py 的 ICONS 表；用法：<text class="icon">&#xe00X;</text> 或 data.icons.xxx */
@font-face {
  font-family: 'xc-icon';
  src: url("data:font/truetype;charset=utf-8;base64,") format("truetype");
}

.icon {
  font-family: 'xc-icon';
  font-size: inherit;
  line-height: 1;
  font-weight: 400;
}

page {
  /* ---- Brand Primary: Mint Macaron ---- */
  --xc-primary: #7CB89E;
  --xc-primary-foreground: #FFFFFF;
  --xc-primary-50: #EDF6F2;
  --xc-primary-100: #D4EBE0;

  /* ---- Surfaces ---- */
  --xc-background: #F6FBF8;
  --xc-surface: #FFFFFF;
  --xc-surface-2: #EFF6F2;

  /* ---- Text ---- */
  --xc-foreground: #1A2822;
  --xc-muted-foreground: #5E7066;
  --xc-placeholder: #9AAFA2;

  /* ---- Lines & Borders ---- */
  --xc-border: #DCE6E0;
  --xc-input: #DCE6E0;
  --xc-ring: #7CB89E;
  --xc-divider: rgba(26, 40, 34, 0.06);

  /* ---- Status / Accent ---- */
  --xc-state-accent: #D4754A;
  --xc-state-accent-foreground: #FFFFFF;
  --xc-state-success: #22C55E;
  --xc-state-warning: #F59E0B;
  --xc-state-error: #EF4444;

  /* ---- Radius ---- */
  --xc-radius-xs: 4rpx;
  --xc-radius-sm: 8rpx;
  --xc-radius-md: 12rpx;
  --xc-radius-lg: 16rpx;
  --xc-radius-pill: 999rpx;

  /* ---- Shadows ---- */
  --xc-shadow-1: 0 2rpx 4rpx rgba(26, 40, 34, 0.04), 0 1rpx 2rpx rgba(26, 40, 34, 0.02);
  --xc-shadow-2: 0 16rpx 48rpx -16rpx rgba(26, 40, 34, 0.04);
  --xc-shadow-3: 0 48rpx 120rpx -40rpx rgba(26, 40, 34, 0.04);

  /* 输入栏顶部与发送按钮专用阴影 */
  --xc-shadow-input-bar: 0 -4rpx 16rpx rgba(26, 40, 34, 0.04);
  --xc-shadow-send: 0 6rpx 16rpx rgba(124, 184, 158, 0.28);

  /* ---- 组件级 Token（P2 支撑） ---- */
  --xc-progress-track: var(--xc-surface-2);
  --xc-progress-fill: var(--xc-primary);
  --xc-progress-fill-warning: var(--xc-state-warning);
  --xc-progress-fill-danger: var(--xc-state-error);
  --xc-progress-bar-height: 8rpx;
  --xc-progress-ring-width: 12rpx;

  /* 图表 */
  --xc-chart-line: var(--xc-primary);
  --xc-chart-line-secondary: var(--xc-state-accent);
  --xc-chart-grid: var(--xc-border);
  --xc-chart-tooltip-bg: var(--xc-foreground);
  --xc-chart-tooltip-fg: var(--xc-surface);

  /* 列表与卡片 */
  --xc-list-icon-bg: var(--xc-primary-50);
  --xc-list-item-height: 96rpx;
  --xc-section-gap: 24rpx;
  --xc-card-padding: 32rpx;

  /* 数据字号 */
  --xc-font-size-data-xl: 56rpx;
  --xc-font-size-data-lg: 44rpx;
  --xc-font-size-data-md: 36rpx;
  --xc-font-size-data-sm: 24rpx;
  --xc-line-height-tight: 1.2;

  /* 连续打卡/强调 */
  --xc-streak: #F59E0B;

  /* ---- Typography ---- */
  --xc-font-sans: "PingFang SC", "Microsoft YaHei", system-ui, -apple-system, sans-serif;

  /* ---- Layout ---- */
  --xc-nav-height: 88rpx;

  /* 背景与文字 */
  background-color: var(--xc-background);
  color: var(--xc-foreground);
  font-family: var(--xc-font-sans);
  font-size: 30rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ---- 基础工具类 ---- */
.xc-page {
  min-height: 100vh;
  background-color: var(--xc-background);
}

/* 隐藏滚动条 */
.xc-no-scrollbar::-webkit-scrollbar {
  display: none;
}

/* 安全区域 */
.xc-safe-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.xc-safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 单行省略 */
.xc-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 启动闪屏 */
.splash {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: var(--xc-primary);
  padding: 0 60rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  font-size: 144rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.brand-subtitle {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
}

.tagline {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 48rpx;
}

.tagline-main {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.tagline-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 加载指示 */
.loading {
  position: absolute;
  bottom: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dots {
  display: flex;
  gap: 16rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.7);
  animation: dotPulse 1.4s ease-in-out infinite;
}

.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.2s; }
.dot-3 { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}
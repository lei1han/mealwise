<!-- 摸底定标聊天 -->
<view class="chat-page">
  <!-- 导航栏：padding-top 避让状态栏/刘海/灵动岛，内容区与微信胶囊等高 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-content" style="height: {{navBarHeight}}px">
      <text class="nav-title">三餐教练</text>
    </view>
  </view>

  <!-- 聊天区域 -->
  <scroll-view
    class="chat-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-into-view="msg-{{messages.length - 1}}"
    scroll-with-animation
  >
    <view class="chat-list">
      <block wx:for="{{messages}}" wx:key="index" wx:for-item="msg">
        <!-- 教练消息 -->
        <view wx:if="{{msg.role === 'coach'}}" class="msg-row msg-coach" id="msg-{{index}}">
          <view class="msg-avatar coach-avatar">
            <text class="avatar-icon">教</text>
          </view>
          <view class="msg-bubble msg-bubble-coach">
            <text>{{msg.text}}</text>
          </view>
        </view>

        <!-- 用户消息 -->
        <view wx:else class="msg-row msg-user" id="msg-{{index}}">
          <view class="msg-bubble msg-bubble-user">
            <text>{{msg.text}}</text>
          </view>
        </view>
      </block>

      <!-- 教练正在输入 -->
      <view wx:if="{{coachTyping}}" class="msg-row msg-coach">
        <view class="msg-avatar coach-avatar">
          <text class="avatar-icon">教</text>
        </view>
        <view class="typing-indicator">
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
        </view>
      </view>

      <view class="chat-bottom"></view>
    </view>
  </scroll-view>

  <!-- 快速回复 -->
  <view wx:if="{{showQuickReplies}}" class="quick-replies">
    <view class="quick-replies-inner">
      <view
        wx:for="{{quickReplies}}"
        wx:key="index"
        class="qr-btn {{item.type === 'primary' ? 'qr-btn-primary' : 'qr-btn-secondary'}}"
        data-action="{{item.action}}"
        data-text="{{item.text}}"
        bindtap="handleQuickReply"
      >{{item.text}}</view>
    </view>
  </view>

  <!-- 输入栏 -->
  <view class="input-bar" style="padding-bottom: {{keyboardHeight > 0 ? keyboardHeight + 'px' : 'env(safe-area-inset-bottom)'}}">
    <view class="input-inner">
      <!-- 原生 input 在 flex 布局下 flex:1 不生效，需用 view 包裹拉伸 -->
      <view class="input-wrap">
        <input
          class="chat-input"
          type="text"
          placeholder="输入你的回复..."
          placeholder-class="chat-input-ph"
          value="{{inputText}}"
          bindinput="handleInput"
          bindconfirm="handleSend"
          confirm-type="send"
          adjust-position="{{false}}"
          cursor-spacing="20"
        />
      </view>
      <button class="send-btn {{canSend ? 'send-btn-active' : ''}}" bindtap="handleSend" disabled="{{!canSend}}">
        发送
      </button>
    </view>
  </view>
</view>
/* 摸底定标聊天 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--xc-background);
}

/* ---- 导航栏 ---- */
.nav-bar {
  background-color: var(--xc-background);
  border-bottom: 1rpx solid var(--xc-border);
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--xc-foreground);
}

/* ---- 聊天区域 ---- */
.chat-scroll {
  flex: 1;
  overflow-y: auto;
}

.chat-list {
  padding: 24rpx 32rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 32rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-coach {
  justify-content: flex-start;
}

/* 头像 */
.msg-avatar {
  flex-shrink: 0;
  margin-right: 16rpx;
}

.coach-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--xc-primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--xc-primary);
}

/* 气泡 */
.msg-bubble {
  max-width: 75%;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}

.msg-bubble-coach {
  background-color: var(--xc-surface);
  color: var(--xc-foreground);
  border: 1rpx solid var(--xc-border);
  border-radius: var(--xc-radius-lg) var(--xc-radius-lg) var(--xc-radius-lg) var(--xc-radius-xs);
  box-shadow: var(--xc-shadow-1);
}

.msg-bubble-user {
  background-color: var(--xc-primary);
  color: #FFFFFF;
  border-radius: var(--xc-radius-lg) var(--xc-radius-xs) var(--xc-radius-lg) var(--xc-radius-lg);
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 28rpx;
  background-color: var(--xc-surface);
  border: 1rpx solid var(--xc-border);
  border-radius: var(--xc-radius-lg);
  box-shadow: var(--xc-shadow-1);
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--xc-muted-foreground);
  animation: dotPulse 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

.chat-bottom {
  height: 20rpx;
}

/* ---- 快速回复 ---- */
.quick-replies {
  padding: 16rpx 32rpx 8rpx;
  background-color: var(--xc-background);
  flex-shrink: 0;
}

.quick-replies-inner {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.qr-btn {
  padding: 20rpx 32rpx;
  border-radius: var(--xc-radius-pill);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.qr-btn-primary {
  background-color: var(--xc-primary);
  color: #FFFFFF;
  box-shadow: var(--xc-shadow-1);
}

.qr-btn-secondary {
  background-color: var(--xc-surface);
  color: var(--xc-foreground);
  border: 2rpx solid var(--xc-border);
}

/* ---- 输入栏 ---- */
.input-bar {
  background-color: var(--xc-background);
  border-top: 1rpx solid var(--xc-border);
  box-shadow: 0 -4rpx 16rpx rgba(26, 38, 32, 0.04);
  flex-shrink: 0;
}

.input-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx;
}

/* 包裹层负责 flex 拉伸（原生 input 直接做 flex 子项不生效） */
.input-wrap {
  flex: 1;
  min-width: 0;
}

.chat-input {
  width: 100%;
  height: 88rpx;
  padding: 0 15rpx;
  background-color: var(--xc-surface);
  border: 1rpx solid var(--xc-input);
  border-radius: var(--xc-radius-pill);
  font-size: 30rpx;
  color: var(--xc-foreground);
  box-sizing: border-box;
}

.chat-input-ph {
  color: var(--xc-placeholder);
}

.send-btn {
  flex-shrink: 0;
  height: 88rpx;
  min-width: 68rpx;
  margin: 0;
  padding: 0 15rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--xc-radius-pill);
  border: none;
  box-sizing: border-box;
}

/* 禁用态：特异性需高于微信内置 button[disabled]，否则会被默认浅灰样式覆盖 */
.send-btn[disabled] {
  background-color: var(--xc-primary-50);
  color: rgba(78, 122, 92, 0.55);
  opacity: 1;
}

.send-btn-active {
  background-color: var(--xc-primary);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(78, 122, 92, 0.28);
}

.send-btn::after {
  border: none;
}